# Copy to .env.local for development. Never commit real values.
# Empty/missing values are handled: the site omits what isn't configured.

# ---------- Public site ----------
# Canonical URL of the deployment (used for metadata, sitemap, emails).
# Production: https://corsaautodetailing.com   Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://corsaautodetailing.com
# "production" (default) or "staging" (noindex + empty sitemap).
NEXT_PUBLIC_SITE_ENV=production
# PRELAUNCH (default) or LIVE. LIVE changes the primary CTA and allows appointment confirmation in /admin.
NEXT_PUBLIC_BUSINESS_MODE=PRELAUNCH
# Confirmed opening date (YYYY-MM-DD). Leave empty until decided — the site never invents one.
NEXT_PUBLIC_LAUNCH_DATE=

# Public contact details. Leave empty to omit from the site (no placeholders are shown).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Human-readable reply hours, e.g. "Mon–Sat, 9am–6pm ET". Empty = no response-time claim.
NEXT_PUBLIC_RESPONSE_HOURS=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=

# Analytics: none (default) | console (dev logging) | plausible
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ---------- Lead storage (Supabase) ----------
# Server-only. When both are set, leads are stored in Postgres. When missing in
# development the local demo store (.data/demo-store.json) is used. In production
# with these missing, forms fail closed with an "unavailable" notice.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional private bucket for vehicle photos (created by the migration as "lead-photos").
# Leave empty to hide the photo upload control entirely.
SUPABASE_STORAGE_BUCKET=

# ---------- Owner dashboard auth (Supabase Auth) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated emails allowed into /admin. Create these users in Supabase Auth (no public signup).
ADMIN_EMAILS=
# Development only: single password for /admin when Supabase Auth is not configured. Ignored in production.
DEMO_ADMIN_PASSWORD=

# ---------- Email (Resend) ----------
# When both set, real emails are sent. Otherwise: dev writes to .data/demo-outbox.json; production skips and logs "skipped".
RESEND_API_KEY=
# Must be a verified sender on your Resend domain, e.g. "Corsa Auto Detailing <hello@yourdomain.com>"
EMAIL_FROM=
# Where owner alerts go.
OWNER_NOTIFY_EMAIL=

# ---------- Operations ----------
# Bearer token for POST /api/cron/retry-notifications. Empty disables the endpoint.
CRON_SECRET=
# Explicit override to allow the demo store in production. Do NOT set this on a real deployment.
# ALLOW_DEMO_STORE=false
