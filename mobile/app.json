{
  "expo": {
    "name": "Corsa Owner",
    "slug": "corsa-owner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "corsaowner",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c0d10",
    "ios": {
      "bundleIdentifier": "com.corsaautodetailing.owner",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.corsaautodetailing.owner",
      "adaptiveIcon": {
        "backgroundColor": "#0c0d10",
        "foregroundImage": "./assets/splash-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0c0d10"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://corsaautodetailing.com",
      "router": {},
      "eas": {
        "projectId": "a74d83a3-0af8-4042-babb-773d25e3ecd5"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "owner": "hersoncorsa",
    "updates": {
      "url": "https://u.expo.dev/a74d83a3-0af8-4042-babb-773d25e3ecd5"
    }
  }
}
