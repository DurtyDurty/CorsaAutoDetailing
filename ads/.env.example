# Copy to ads/.env (git-ignored). Never commit real values. The CLI never prints them.

# Optional since 2026-09-09: API access now belongs to the Google Cloud project
# (Cloud Console > Google Ads API > Upgrade access level). Kept for older client versions.
GOOGLE_ADS_DEVELOPER_TOKEN=

# OAuth client of type "Desktop app" from a Google Cloud project with the
# Google Ads API and Data Manager API enabled.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Filled in by: python -m corsa_ads auth-login
# (scopes: https://www.googleapis.com/auth/adwords and https://www.googleapis.com/auth/datamanager)
GOOGLE_ADS_REFRESH_TOKEN=

# The Corsa Google Ads account (10 digits, dashes optional).
GOOGLE_ADS_CUSTOMER_ID=
# Only if you sign in through a manager account: the manager's id.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
